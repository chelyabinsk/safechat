import { Button, ComboBox, GroupBox, HorizontalBox, LineEdit, ListView, VerticalBox } from "std-widgets.slint";

export struct ChatMessage {
    sender: string,
    text: string,
    timestamp: string,
    outgoing: bool,
    status: string,
    ciphertext: string,
}

export component MainWindow inherits Window {
    title: "SafeChat";
    preferred-width: 980px;
    preferred-height: 680px;

    in-out property <string> status-text: "Ready";
    in-out property <string> profile-name: "default";
    in-out property <bool> profile-exists: false;
    in-out property <[string]> available-profiles: [];
    in-out property <string> selected-profile: "";
    in-out property <bool> creating-profile: false;
    in-out property <string> contact-name: "";
    in-out property <string> contact-bundle: "";
    in-out property <bool> contact-added: false;
    in-out property <bool> conversation-selected: false;
    in-out property <bool> chat-loading: false;
    in-out property <bool> history-loading: false;
    in-out property <string> loading-text: "Decrypting chat history…";
    in-out property <[ChatMessage]> chat-messages: [];
    in-out property <string> selected-transport: "Copy/paste";
    in-out property <[string]> transport-options: [];
    in-out property <bool> profile-ready: false;
    in-out property <string> fingerprint: "";
    in-out property <string> public-bundle: "";
    in-out property <bool> new-chat-open: false;
    in-out property <bool> profile-info-open: false;
    in-out property <bool> history-has-more: false;
    in-out property <int> scroll-generation: 0;
    in-out property <string> copied-ciphertext: "";
    callback choose-transport(string);
    callback send-message(string);
    callback initialize-profile(string, string, string);
    callback new-chat();
    callback copy-bundle();
    callback copy-fingerprint();
    callback begin-create-profile();
    callback select-profile(string);
    callback verify-add-contact(string, string, string);
    callback select-contact();
    callback receive-pasted(string);
    callback copy-ciphertext(string);
    callback load-older-history();

    Rectangle {
        background: #f7f8fa;

        VerticalBox {
            spacing: 0px;

            Rectangle {
                height: 64px;
                background: #075e54;
                HorizontalBox {
                    padding-left: 22px;
                    padding-right: 22px;
                    Text { text: "SafeChat"; color: white; font-size: 24px; }
                    Text { text: "  " + root.profile-name; color: #d7f5ef; horizontal-stretch: 1; }
                    if root.conversation-selected && !root.history-loading: ComboBox {
                        model: root.transport-options;
                        selected(value) => { root.selected-transport = value; root.choose-transport(value); }
                    }
                    Button { text: "My profile"; enabled: root.profile-ready; clicked => { root.profile-info-open = true; } }
                    Text { text: root.profile-ready ? "● Ready" : ""; color: #d7f5ef; }
                }
            }

            HorizontalBox {
                spacing: 0px;

                Rectangle {
                    width: 300px;
                    background: white;
                    VerticalBox {
                        padding: 18px;
                        spacing: 14px;
                        Text { text: "Chats"; font-size: 22px; color: #1f2933; }
                        LineEdit { placeholder-text: "Search conversations"; }
                        Button {
                            text: "＋  New conversation";
                            clicked => { root.new-chat(); }
                        }
                        if root.contact-added: TouchArea {
                            height: 70px;
                            enabled: !root.chat-loading;
                            clicked => { root.select-contact(); }
                            Rectangle {
                                background: #e8f5f2;
                                VerticalBox {
                                    padding: 10px;
                                    Text { text: root.contact-name; font-size: 16px; color: #1f2933; }
                                    Text { text: "Verified contact"; color: #667781; }
                                }
                            }
                        }
                        if !root.contact-added: Text { text: "No conversations yet"; color: #667781; horizontal-alignment: center; vertical-stretch: 1; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    background: #efeae2;
                    horizontal-stretch: 1;
                    VerticalBox {
                        padding: 24px;
                        spacing: 12px;
                        if root.contact-added && root.conversation-selected && !root.new-chat-open && !root.history-loading: Text {
                            text: "Conversation with " + root.contact-name;
                            font-size: 24px;
                            color: #41525d;
                            horizontal-alignment: center;
                        }
                        if root.contact-added && root.conversation-selected && !root.new-chat-open && !root.history-loading && !root.chat-loading && root.history-has-more: Button {
                            text: "Load older messages";
                            clicked => { root.load-older-history(); }
                        }
                        if root.contact-added && root.conversation-selected && !root.new-chat-open && !root.history-loading: ListView {
                            vertical-stretch: 1;
                            for message in root.chat-messages: HorizontalBox {
                                width: parent.width;
                                    Rectangle { horizontal-stretch: message.outgoing ? 1 : 0; }
                                    message_area := TouchArea {
                                        width: 360px;
                                        height: message_bubble.height;
                                        clicked => { root.copy-ciphertext(message.ciphertext); }
                                        message_bubble := Rectangle {
                                            width: parent.width;
                                            height: max(72px, message_content.preferred-height);
                                            background: message.ciphertext == root.copied-ciphertext
                                                ? #b7ebc6
                                                : message.outgoing ? #d9fdd3 : white;
                                            animate background { duration: 180ms; }
                                            border-radius: 10px;
                                            message_content := VerticalBox {
                                                width: parent.width;
                                                padding: 10px;
                                                spacing: 3px;
                                                Text { text: message.sender; color: #667781; font-size: 12px; }
                                                Text { text: message.text; width: parent.width - 20px; color: #1f2933; wrap: word-wrap; }
                                                HorizontalBox {
                                                    Text { text: message.timestamp; color: #8696a0; font-size: 10px; horizontal-stretch: 1; }
                                                    if message.outgoing: Text { text: message.status; color: #667781; font-size: 10px; }
                                                }
                                            }
                                        }
                                    }
                                Rectangle { horizontal-stretch: message.outgoing ? 0 : 1; }
                            }
                        }
                        if root.new-chat-open: GroupBox {
                            title: "New conversation";
                            width: 520px;
                            height: 270px;
                            vertical-stretch: 0;
                            VerticalBox {
                                padding: 18px;
                                spacing: 12px;
                                Text { text: "Exchange public bundles through a trusted channel, then verify the fingerprint."; color: #667781; wrap: word-wrap; }
                                peer_bundle := LineEdit { placeholder-text: "Contact public bundle"; }
                                peer_fingerprint := LineEdit { placeholder-text: "Verified contact fingerprint"; }
                                peer_password := LineEdit { placeholder-text: "Your profile password"; input-type: InputType.password; }
                                Button { text: "Verify and add contact"; clicked => { root.verify-add-contact(peer_bundle.text, peer_fingerprint.text, peer_password.text); } }
                            }
                        }
                        if root.contact-added && !root.conversation-selected && !root.new-chat-open: Text {
                            text: "Contact added — select it to open the chat";
                            font-size: 22px;
                            color: #41525d;
                            horizontal-alignment: center;
                            vertical-stretch: 1;
                        }
                        if !root.contact-added && !root.new-chat-open: Text {
                            text: "Select a conversation";
                            font-size: 24px;
                            color: #41525d;
                            horizontal-alignment: center;
                            vertical-stretch: 1;
                        }
                        if !root.chat-loading: Text { text: root.status-text; color: #667781; horizontal-alignment: center; }
                        if root.conversation-selected && root.chat-loading: Text {
                            text: root.loading-text;
                            color: #667781;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                        if root.conversation-selected && !root.chat-loading: HorizontalBox {
                            height: 40px;
                            spacing: 8px;
                            message_input := LineEdit {
                                placeholder-text: "Type a message";
                                horizontal-stretch: 1;
                                height: 40px;
                                enabled: root.profile-ready;
                            }
                            Button { text: "Send"; height: 40px; enabled: root.profile-ready; clicked => { root.send-message(message_input.text); message_input.text = ""; } }
                        }
                        if root.conversation-selected && !root.chat-loading && root.selected-transport == "Copy/paste": HorizontalBox {
                            height: 40px;
                            paste_input := LineEdit {
                                placeholder-text: "Paste encrypted message here";
                                horizontal-stretch: 1;
                                height: 40px;
                                enabled: root.profile-ready;
                            }
                            Button {
                                text: "Receive pasted";
                                height: 40px;
                                enabled: root.profile-ready;
                                clicked => { root.receive-pasted(paste_input.text); paste_input.text = ""; }
                            }
                        }
                    }
                }
            }
        }

        if !root.profile-ready: Rectangle {
            background: #00000099;
            width: parent.width;
            height: parent.height;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 540px;
                height: 560px;
                background: white;
                border-radius: 12px;
                VerticalBox {
                    padding: 30px;
                    spacing: 14px;
                    if !root.creating-profile: Text { text: "Unlock SafeChat"; font-size: 28px; color: #075e54; }
                    if root.creating-profile: Text { text: "Create a SafeChat profile"; font-size: 28px; color: #075e54; }
                    if !root.creating-profile: Text { text: "Select a profile and enter its password."; color: #667781; wrap: word-wrap; }
                    if root.creating-profile: Text { text: "Create a separate encrypted identity for another user."; color: #667781; wrap: word-wrap; }
                    if !root.creating-profile: ComboBox {
                        model: root.available-profiles;
                        selected(value) => { root.selected-profile = value; root.select-profile(value); }
                    }
                    display_name := LineEdit { placeholder-text: "Profile name"; text: root.profile-name; visible: root.creating-profile; }
                    password := LineEdit { placeholder-text: "Password"; input-type: InputType.password; }
                    password_confirm := LineEdit { placeholder-text: "Confirm password"; input-type: InputType.password; visible: root.creating-profile; }
                    Button {
                        text: root.creating-profile ? "Create profile" : "Unlock profile";
                        clicked => { root.initialize-profile(root.creating-profile ? display_name.text : root.selected-profile, password.text, root.creating-profile ? password_confirm.text : password.text); }
                    }
                    Button { text: root.creating-profile ? "Back to profiles" : "Create new profile"; clicked => { root.begin-create-profile(); } }
                    if root.fingerprint == "": Text { text: root.status-text; color: #667781; wrap: word-wrap; }
                    if root.fingerprint != "": TouchArea {
                        width: 480px;
                        height: 56px;
                        clicked => { root.copy-fingerprint(); }
                        Text { text: "Fingerprint: " + root.fingerprint; color: #667781; wrap: char-wrap; width: 480px; horizontal-alignment: center; }
                    }
                }
            }
        }

        if root.profile-info-open: Rectangle {
            background: #00000099;
            width: parent.width;
            height: parent.height;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 480px;
                height: 300px;
                background: white;
                border-radius: 12px;
                VerticalBox {
                    padding: 28px;
                    spacing: 14px;
                    Text { text: "My profile"; font-size: 26px; color: #075e54; }
                    Text { text: "Your fingerprint"; color: #667781; }
                    TouchArea {
                        width: 424px;
                        height: 64px;
                        clicked => { root.copy-fingerprint(); }
                        Text { text: root.fingerprint; font-size: 20px; color: #1f2933; wrap: char-wrap; width: 424px; horizontal-alignment: center; }
                    }
                    Text { text: "Share the public bundle only through a trusted channel."; color: #667781; wrap: word-wrap; }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: "Copy public bundle"; clicked => { root.copy-bundle(); } }
                        Button { text: "Close"; clicked => { root.profile-info-open = false; } }
                    }
                }
            }
        }
    }
}
