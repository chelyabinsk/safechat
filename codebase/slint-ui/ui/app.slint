import { ComboBox, GroupBox, HorizontalBox, LineEdit, ListView, Palette, VerticalBox } from "std-widgets.slint";

component AppButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    border-radius: 9px;
    background: primary ? #087f70 : #e8f0ee;
    border-width: 1px;
    border-color: primary ? #087f70 : #d5e2de;
    animate background { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.primary ? white : #23433f;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HeaderButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: header_touch.pressed ? #145f56 : #0b7166;
    border-width: 1px;
    border-color: #2b887c;
    animate background { duration: 120ms; }

    header_touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: white;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HeaderSelector inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: max(142px, selector_label.preferred-width + 44px);
    height: 36px;
    border-radius: 8px;
    background: selector_touch.pressed ? #145f56 : #0b7166;
    border-width: 1px;
    border-color: #2b887c;
    animate background { duration: 120ms; }

    selector_touch := TouchArea {
        clicked => { root.clicked(); }
    }
    selector_label := Text {
        text: root.label;
        color: white;
        font-size: 13px;
        font-weight: 600;
        x: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: "▾";
        color: #bde7df;
        font-size: 14px;
        x: parent.width - 22px;
        width: 14px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component FlagIcon inherits Rectangle {
    in property <string> country;
    width: 24px;
    height: 16px;
    border-radius: 2px;
    clip: true;
    background: country == "ru" ? #ffffff : #1f3f95;

    if country == "ru": Rectangle { x: 0px; y: 0px; width: parent.width; height: 5px; background: white; }
    if country == "ru": Rectangle { x: 0px; y: 5px; width: parent.width; height: 6px; background: #1f4f9b; }
    if country == "ru": Rectangle { x: 0px; y: 11px; width: parent.width; height: 5px; background: #d52b1e; }
    if country != "ru": Path {
        width: parent.width;
        height: parent.height;
        fill: white;
        MoveTo { x: 0; y: 0; }
        LineTo { x: 3; y: 0; }
        LineTo { x: 24; y: 13; }
        LineTo { x: 24; y: 16; }
        Close {}
    }
    if country != "ru": Path {
        width: parent.width;
        height: parent.height;
        fill: white;
        MoveTo { x: 21; y: 0; }
        LineTo { x: 24; y: 0; }
        LineTo { x: 3; y: 16; }
        LineTo { x: 0; y: 16; }
        Close {}
    }
    if country != "ru": Path {
        width: parent.width;
        height: parent.height;
        fill: #d51f36;
        MoveTo { x: 0; y: 0; }
        LineTo { x: 1; y: 0; }
        LineTo { x: 24; y: 14; }
        LineTo { x: 24; y: 15; }
        Close {}
    }
    if country != "ru": Path {
        width: parent.width;
        height: parent.height;
        fill: #d51f36;
        MoveTo { x: 23; y: 0; }
        LineTo { x: 24; y: 0; }
        LineTo { x: 1; y: 16; }
        LineTo { x: 0; y: 16; }
        Close {}
    }
    if country != "ru": Rectangle {
        x: 0px;
        y: 6px;
        width: parent.width;
        height: 4px;
        background: white;
        Rectangle { x: 9px; y: -6px; width: 6px; height: 16px; background: white; }
    }
    if country != "ru": Rectangle {
        x: 0px;
        y: 7px;
        width: parent.width;
        height: 2px;
        background: #d51f36;
        Rectangle { x: 11px; y: -7px; width: 3px; height: 16px; background: #d51f36; }
    }
}

export struct ChatMessage {
    sender: string,
    text: string,
    timestamp: string,
    outgoing: bool,
    status: string,
    ciphertext: string,
}

export struct UiText {
    my-profile: string,
    ready: string,
    conversations: string,
    search-conversations: string,
    new-conversation: string,
    verified-contact: string,
    no-conversations: string,
    verified-encrypted: string,
    load-older: string,
    new-conversation-help: string,
    contact-bundle: string,
    contact-fingerprint: string,
    profile-password: string,
    verify-add-contact: string,
    contact-added: string,
    select-conversation: string,
    type-message: string,
    send: string,
    paste-encrypted: string,
    receive-pasted: string,
    unlock: string,
    create-profile: string,
    unlock-help: string,
    create-help: string,
    profile-name: string,
    password: string,
    confirm-password: string,
    create-profile-button: string,
    unlock-profile: string,
    back-to-profiles: string,
    create-new-profile: string,
    fingerprint: string,
    your-fingerprint: string,
    share-bundle: string,
    copy-bundle: string,
    close: string,
    data-location: string,
    delete-chat: string,
    delete-chat-confirmation: string,
    chat-deleted: string,
    you: string,
    today: string,
    yesterday: string,
    copied: string,
    chat-history-loaded: string,
    sent: string,
    received: string,
    decrypting-chat-history: string,
    deleting-chat-history: string,
    encrypting-sending: string,
    decrypting-pasted: string,
    copy-paste: string,
    relay: string,
    language-english: string,
    language-russian: string,
}

export component MainWindow inherits Window {
    title: "SafeChat";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 1080px;
    max-width: 1080px;
    min-height: 720px;
    max-height: 720px;

    in property <UiText> locale;

    in-out property <string> status-text: "Ready";
    in-out property <string> app-version: "";
    in-out property <string> profile-name: "default";
    in-out property <bool> profile-exists: false;
    in-out property <[string]> available-profiles: [];
    in-out property <string> selected-profile: "";
    in-out property <bool> creating-profile: false;
    in-out property <string> contact-name: "";
    in-out property <string> contact-bundle: "";
    in-out property <bool> contact-added: false;
    in-out property <bool> conversation-selected: false;
    in-out property <bool> chat-loading: false;
    in-out property <bool> history-loading: false;
    in-out property <string> loading-text: "Decrypting chat history…";
    in-out property <[ChatMessage]> chat-messages: [];
    in-out property <string> selected-transport: "Copy/paste";
    in-out property <[string]> transport-options: [];
    in-out property <string> selected-language: "en";
    in-out property <bool> language-menu-open: false;
    in-out property <bool> transport-menu-open: false;
    in-out property <bool> profile-ready: false;
    in-out property <string> fingerprint: "";
    in-out property <string> public-bundle: "";
    in-out property <bool> new-chat-open: false;
    in-out property <bool> profile-info-open: false;
    in-out property <string> data-directory: "";
    in-out property <bool> delete-chat-confirm-open: false;
    in-out property <bool> history-has-more: false;
    in-out property <int> scroll-generation: 0;
    in-out property <string> copied-ciphertext: "";
    // The widget palette tracks the desktop light/dark preference. Keep the
    // application surfaces aligned with it instead of mixing a light shell
    // with dark native controls.
    property <bool> dark-theme: Palette.color-scheme == ColorScheme.dark;
    property <color> app-background: dark-theme ? #111918 : #eef4f2;
    property <color> panel-background: dark-theme ? #182321 : white;
    property <color> elevated-background: dark-theme ? #202e2b : white;
    property <color> primary-text: dark-theme ? #eef7f4 : #1f2933;
    property <color> secondary-text: dark-theme ? #b5c8c3 : #667781;
    property <color> muted-text: dark-theme ? #91aaa3 : #526865;
    property <color> input-background: dark-theme ? #263733 : #f7faf9;
    property <color> input-border: dark-theme ? #46635c : #d5e2de;
    property <color> bubble-incoming: dark-theme ? #202e2b : white;
    property <color> bubble-outgoing: dark-theme ? #17483f : #d9f5e9;
    property <color> bubble-border: dark-theme ? #38514b : #e4eae8;
    callback choose-transport(string);
    callback choose-language(string);
    callback send-message(string);
    callback initialize-profile(string, string, string);
    callback new-chat();
    callback copy-bundle();
    callback copy-fingerprint();
    callback begin-create-profile();
    callback select-profile(string);
    callback verify-add-contact(string, string, string);
    callback select-contact();
    callback receive-pasted(string);
    callback copy-ciphertext(string);
    callback load-older-history();
    callback delete-chat();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.app-background;

        VerticalBox {
            vertical-stretch: 1;
            spacing: 0px;

            Rectangle {
                height: 72px;
                background: #06483f;
                border-width: 1px;
                border-color: #0b7064;
                HorizontalBox {
                    padding-left: 22px;
                    padding-right: 22px;
                    spacing: 12px;
                    Text { text: "SafeChat"; color: white; font-size: 25px; font-weight: 600; }
                    Text { text: root.app-version; color: #9cc8c1; font-size: 11px; vertical-alignment: center; }
                    Rectangle {
                        width: 1px;
                        height: 28px;
                        background: #39877d;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: 8px;
                        background: #0a584f;
                        border-width: 1px;
                        border-color: #1d746a;
                        Text {
                            text: root.profile-name;
                            color: #d2eee9;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                            x: 12px;
                            width: parent.width - 24px;
                            overflow: elide;
                        }
                    }
                    if root.conversation-selected && !root.history-loading: HeaderSelector {
                        label: root.selected-transport;
                        clicked => { root.transport-menu-open = !root.transport-menu-open; root.language-menu-open = false; }
                    }
                    if !root.history-loading: Rectangle {
                        width: 42px;
                        height: 36px;
                        border-radius: 8px;
                        background: language_menu_touch.pressed ? #145f56 : #0b7166;
                        border-width: 1px;
                        border-color: #2b887c;
                        animate background { duration: 120ms; }
                        language_menu_touch := TouchArea {
                            clicked => { root.language-menu-open = !root.language-menu-open; root.transport-menu-open = false; }
                        }
                        FlagIcon { country: root.selected-language; x: 9px; y: 10px; }
                    }
                    HeaderButton { label: root.locale.my-profile; enabled: root.profile-ready; clicked => { root.profile-info-open = true; } }
                    Rectangle {
                        width: 78px;
                        height: 28px;
                        border-radius: 14px;
                        background: root.profile-ready ? #0b7166 : #0a584f;
                        Text {
                            text: root.profile-ready ? "●  " + root.locale.ready : "";
                            color: #d2eee9;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalBox {
                vertical-stretch: 1;
                spacing: 0px;

                Rectangle {
                    width: 292px;
                    vertical-stretch: 1;
                    background: root.panel-background;
                    VerticalBox {
                        padding: 18px;
                        spacing: 12px;
                        Text { text: root.locale.conversations; font-size: 22px; color: root.primary-text; font-weight: 600; }
                        LineEdit { placeholder-text: root.locale.search-conversations; }
                    AppButton {
                        label: "＋  " + root.locale.new-conversation;
                        primary: true;
                        height: 42px;
                        clicked => { root.new-chat(); }
                        }
                        if root.contact-added: TouchArea {
                            height: 76px;
                            enabled: !root.chat-loading;
                            clicked => { root.select-contact(); }
                            Rectangle {
                                background: root.conversation-selected && !root.new-chat-open ? (root.dark-theme ? #24554c : #dff3ee) : (root.dark-theme ? #22312e : #f3f6f5);
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: root.conversation-selected && !root.new-chat-open ? (root.dark-theme ? #4b8d80 : #a8d9cf) : (root.dark-theme ? #344944 : #e5eae8);
                                animate background { duration: 160ms; }
                                VerticalBox {
                                    padding: 12px;
                                    spacing: 3px;
                                    Text { text: root.contact-name; font-size: 16px; color: root.primary-text; font-weight: 600; }
                                    Text { text: root.locale.verified-contact; color: root.secondary-text; font-size: 12px; }
                                }
                            }
                        }
                        if !root.contact-added: Text { text: root.locale.no-conversations; color: root.secondary-text; horizontal-alignment: center; vertical-stretch: 1; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: root.app-background;
                    horizontal-stretch: 1;
                    VerticalBox {
                        padding: 26px;
                        spacing: 14px;
                        if root.contact-added && root.conversation-selected && !root.new-chat-open && !root.history-loading: HorizontalBox {
                            height: 34px;
                            spacing: 8px;
                            Text { text: root.contact-name; height: parent.height; font-size: 19px; color: root.primary-text; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.locale.verified-encrypted; height: parent.height; color: root.secondary-text; font-size: 12px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.contact-added && root.conversation-selected && !root.new-chat-open && !root.history-loading && !root.chat-loading && root.history-has-more: AppButton {
                            label: root.locale.load-older + "  ↑";
                            width: 190px;
                            clicked => { root.load-older-history(); }
                        }
                        if root.contact-added && root.conversation-selected && !root.new-chat-open && !root.history-loading: ListView {
                            vertical-stretch: 1;
                            // ListView uses a negative content offset. After the
                            // initial page is loaded, jump to the newest messages.
                            viewport-y: root.scroll-generation > 0
                                ? min(0px, self.height - self.viewport-height)
                                : 0px;
                            for message in root.chat-messages: HorizontalBox {
                                width: parent.width;
                                    Rectangle { horizontal-stretch: message.outgoing ? 1 : 0; }
                                    message_area := TouchArea {
                                        width: 380px;
                                        height: message_bubble.height;
                                        clicked => { root.copy-ciphertext(message.ciphertext); }
                                        message_bubble := Rectangle {
                                            width: parent.width;
                                            height: max(68px, message_content.preferred-height);
                                            background: message.ciphertext == root.copied-ciphertext
                                                ? (root.dark-theme ? #2c6a54 : #b9e8c8)
                                                : message.outgoing ? root.bubble-outgoing : root.bubble-incoming;
                                            animate background { duration: 180ms; }
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: message.ciphertext == root.copied-ciphertext
                                                ? #76c996
                                                : message.outgoing ? (root.dark-theme ? #3c7565 : #c2e8dc) : root.bubble-border;
                                            message_content := VerticalBox {
                                                width: parent.width;
                                                padding: 12px;
                                                spacing: 4px;
                                                Text { text: message.sender; color: root.muted-text; font-size: 12px; font-weight: 600; }
                                                Text { text: message.text; width: parent.width - 20px; color: root.primary-text; wrap: word-wrap; }
                                                HorizontalBox {
                                                    Text { text: message.timestamp; color: root.secondary-text; font-size: 10px; horizontal-stretch: 1; }
                                                    if message.outgoing: Text { text: message.status; color: root.secondary-text; font-size: 10px; }
                                                }
                                            }
                                        }
                                    }
                                Rectangle { horizontal-stretch: message.outgoing ? 0 : 1; }
                            }
                        }
                        if root.new-chat-open: GroupBox {
                            title: root.locale.new-conversation;
                            width: 520px;
                            height: 270px;
                            vertical-stretch: 0;
                            VerticalBox {
                                padding: 22px;
                                spacing: 12px;
                                Text { text: root.locale.new-conversation-help; color: root.muted-text; wrap: word-wrap; }
                                peer_bundle := LineEdit { placeholder-text: root.locale.contact-bundle; }
                                peer_fingerprint := LineEdit { placeholder-text: root.locale.contact-fingerprint; }
                                peer_password := LineEdit { placeholder-text: root.locale.profile-password; input-type: InputType.password; }
                                AppButton { label: root.locale.verify-add-contact; primary: true; clicked => { root.verify-add-contact(peer_bundle.text, peer_fingerprint.text, peer_password.text); } }
                            }
                        }
                        if root.contact-added && !root.conversation-selected && !root.new-chat-open: Text {
                            text: root.locale.contact-added;
                            font-size: 22px;
                            color: root.primary-text;
                            horizontal-alignment: center;
                            vertical-stretch: 1;
                        }
                        if !root.contact-added && !root.new-chat-open: Text {
                            text: root.locale.select-conversation;
                            font-size: 24px;
                            color: root.primary-text;
                            horizontal-alignment: center;
                            vertical-stretch: 1;
                        }
                        if !root.chat-loading: Text { text: root.status-text; color: root.secondary-text; horizontal-alignment: center; }
                        if root.conversation-selected && root.chat-loading: Text {
                            text: root.loading-text;
                            color: root.secondary-text;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                        if root.conversation-selected && !root.new-chat-open && !root.chat-loading: HorizontalBox {
                            height: 40px;
                            spacing: 8px;
                            message_input := LineEdit {
                                placeholder-text: root.locale.type-message;
                                horizontal-stretch: 1;
                                height: 40px;
                                enabled: root.profile-ready;
                            }
                            AppButton { label: root.locale.send; primary: true; width: 84px; height: 40px; enabled: root.profile-ready; clicked => { root.send-message(message_input.text); message_input.text = ""; } }
                        }
                        if root.conversation-selected && !root.new-chat-open && !root.chat-loading && root.selected-transport == root.locale.copy-paste: HorizontalBox {
                            height: 40px;
                            paste_input := LineEdit {
                                placeholder-text: root.locale.paste-encrypted;
                                horizontal-stretch: 1;
                                height: 40px;
                                enabled: root.profile-ready;
                            }
                            AppButton {
                                label: root.locale.receive-pasted;
                                height: 40px;
                                width: 142px;
                                enabled: root.profile-ready;
                                clicked => { root.receive-pasted(paste_input.text); paste_input.text = ""; }
                            }
                        }
                    }
                }
            }
        }

        if root.language-menu-open: Rectangle {
            x: parent.width - 190px;
            y: 72px;
            width: 126px;
            height: 84px;
            background: root.elevated-background;
            border-radius: 9px;
            border-width: 1px;
            border-color: root.input-border;
            z: 20;
            VerticalBox {
                width: parent.width;
                height: parent.height;
                padding: 6px;
                spacing: 3px;
                TouchArea {
                    width: parent.width;
                    height: 32px;
                    clicked => { root.choose-language("en"); root.language-menu-open = false; }
                    HorizontalBox { width: parent.width; height: parent.height; spacing: 8px; FlagIcon { country: "en"; } Text { text: root.locale.language-english; color: root.primary-text; vertical-alignment: center; } }
                }
                TouchArea {
                    width: parent.width;
                    height: 32px;
                    clicked => { root.choose-language("ru"); root.language-menu-open = false; }
                    HorizontalBox { width: parent.width; height: parent.height; spacing: 8px; FlagIcon { country: "ru"; } Text { text: root.locale.language-russian; color: root.primary-text; vertical-alignment: center; } }
                }
            }
        }

        if root.transport-menu-open: Rectangle {
            x: parent.width - 360px;
            y: 72px;
            width: 154px;
            height: 84px;
            background: root.elevated-background;
            border-radius: 9px;
            border-width: 1px;
            border-color: root.input-border;
            z: 20;
            VerticalBox {
                width: parent.width;
                height: parent.height;
                padding: 6px;
                spacing: 3px;
                if root.transport-options.length > 0: TouchArea {
                    width: parent.width;
                    height: 32px;
                    clicked => { root.selected-transport = root.transport-options[0]; root.choose-transport(root.transport-options[0]); root.transport-menu-open = false; }
                    Text { text: root.transport-options[0]; color: root.primary-text; x: 10px; width: parent.width - 20px; vertical-alignment: center; overflow: elide; }
                }
                if root.transport-options.length > 1: TouchArea {
                    width: parent.width;
                    height: 32px;
                    clicked => { root.selected-transport = root.transport-options[1]; root.choose-transport(root.transport-options[1]); root.transport-menu-open = false; }
                    Text { text: root.transport-options[1]; color: root.primary-text; x: 10px; width: parent.width - 20px; vertical-alignment: center; overflow: elide; }
                }
            }
        }

        if !root.profile-ready: Rectangle {
            background: #00000066;
            width: parent.width;
            height: parent.height;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 540px;
                height: 560px;
                background: root.elevated-background;
                border-radius: 16px;
                border-width: 1px;
                border-color: root.input-border;
                VerticalBox {
                    padding: 32px;
                    spacing: 16px;
                    if !root.creating-profile: Text { text: root.locale.unlock; font-size: 28px; color: #075e54; }
                    if root.creating-profile: Text { text: root.locale.create-profile; font-size: 28px; color: #075e54; }
                    if !root.creating-profile: Text { text: root.locale.unlock-help; color: root.secondary-text; wrap: word-wrap; }
                    if root.creating-profile: Text { text: root.locale.create-help; color: root.secondary-text; wrap: word-wrap; }
                    if !root.creating-profile: ComboBox {
                        model: root.available-profiles;
                        selected(value) => { root.selected-profile = value; root.select-profile(value); }
                    }
                    display_name := LineEdit { placeholder-text: root.locale.profile-name; text: root.profile-name; visible: root.creating-profile; }
                    password := LineEdit { placeholder-text: root.locale.password; input-type: InputType.password; }
                    password_confirm := LineEdit { placeholder-text: root.locale.confirm-password; input-type: InputType.password; visible: root.creating-profile; }
                    AppButton {
                        label: root.creating-profile ? root.locale.create-profile-button : root.locale.unlock-profile;
                        primary: true;
                        clicked => { root.initialize-profile(root.creating-profile ? display_name.text : root.selected-profile, password.text, root.creating-profile ? password_confirm.text : password.text); }
                    }
                    AppButton { label: root.creating-profile ? root.locale.back-to-profiles : root.locale.create-new-profile; clicked => { root.begin-create-profile(); } }
                    if root.fingerprint == "": Text { text: root.status-text; color: root.secondary-text; wrap: word-wrap; }
                    if root.fingerprint != "": TouchArea {
                        width: 480px;
                        height: 56px;
                        clicked => { root.copy-fingerprint(); }
                        Text { text: root.locale.fingerprint + ": " + root.fingerprint; color: root.secondary-text; wrap: char-wrap; width: 480px; horizontal-alignment: center; }
                    }
                }
            }
        }

        if root.profile-info-open: Rectangle {
            background: #00000066;
            width: parent.width;
            height: parent.height;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 480px;
                height: 430px;
                background: root.elevated-background;
                border-radius: 16px;
                border-width: 1px;
                border-color: root.input-border;
                VerticalBox {
                    padding: 28px;
                    spacing: 14px;
                    Text { text: root.locale.my-profile; font-size: 26px; color: #075e54; }
                    Text { text: root.locale.your-fingerprint; color: root.secondary-text; }
                    TouchArea {
                        width: 424px;
                        height: 64px;
                        clicked => { root.copy-fingerprint(); }
                        Text { text: root.fingerprint; font-size: 20px; color: root.primary-text; wrap: char-wrap; width: 424px; horizontal-alignment: center; }
                    }
                    Text { text: root.locale.share-bundle; color: root.secondary-text; wrap: word-wrap; }
                    Text { text: root.locale.data-location + ":"; color: root.secondary-text; }
                    Text { text: root.data-directory; color: root.primary-text; wrap: char-wrap; width: 424px; }
                    if root.conversation-selected && !root.delete-chat-confirm-open: AppButton {
                        label: root.locale.delete-chat;
                        clicked => { root.delete-chat-confirm-open = true; }
                    }
                    if root.delete-chat-confirm-open: Text {
                        text: root.locale.delete-chat-confirmation;
                        color: root.primary-text;
                    }
                    if root.delete-chat-confirm-open: HorizontalBox {
                        spacing: 8px;
                        AppButton { label: root.locale.delete-chat; primary: true; clicked => { root.delete-chat(); root.delete-chat-confirm-open = false; root.profile-info-open = false; } }
                        AppButton { label: root.locale.close; clicked => { root.delete-chat-confirm-open = false; } }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        AppButton { label: root.locale.copy-bundle; primary: true; clicked => { root.copy-bundle(); } }
                        AppButton { label: root.locale.close; clicked => { root.profile-info-open = false; root.delete-chat-confirm-open = false; } }
                    }
                }
            }
        }
    }
}
